//

#include <iostream>
#include <limits>
#include <iomanip>
#include <locale>
#include <cmath>
using namespace std;

int main() {
    // 1.1 Operaciones e impresión de resultados
    cout << "Resultado 1: " << 3 + 5 * 2 / 2 - 1 << endl;
    cout << "Resultado 2: " << 3 + 10 / 2 - 1 << endl;
    cout << "Resultado 3: " << 3 + 5 - 1 << endl;
    cout << "Resultado 4: " << 8 - 1 << endl;
    cout << "Resultado 5: " << 1 / 3 * 3 << endl;  // División entera dará 0.

    // 1.2 Potencia de un número
    int numero;
    cout << "Ingrese un número: ";
    cin >> numero;
    int potencia = numero * numero;
    cout << "La potencia de " << numero << " es " << potencia << endl;

    // 1.3 Conversión de yardas a metros
    double yardas;
    cout << "Ingrese las yardas: ";
    cin >> yardas;
    double metros = yardas * 0.9144;
    cout << "Número en metros: " << metros << endl;

    // 1.4 Depreciación de un auto
    double valorOriginal = 200000;
    double valorDepreciacion = valorOriginal * 0.80;  // 80% de depreciación
    double deduccionPorAño = valorDepreciacion / 5;

    for (int año = 1; año <= 5; ++año) {
        cout << "Deducción del año " << año << ": " << deduccionPorAño << endl;
    }

    // 1.5 Deducción de impuestos del salario mensual
    double salarioMensual = 25000;
    double impuestoFijo = 900;
    double porcentaje = 0.015 * (salarioMensual - impuestoFijo);
    double totalImpuesto = impuestoFijo + porcentaje;
    double salarioNeto = salarioMensual - totalImpuesto;

    cout << "Impuesto a deducir: " << totalImpuesto << endl;
    cout << "Sueldo neto: " << salarioNeto << endl;

    // 1.6 Operaciones en C++
    cout << "3 * 4 = " << 3 * 4 << endl;
    cout << "12 / 3 = " << 12 / 3 << endl;
    cout << "12 % 3 = " << 12 % 3 << endl;
    cout << "12 % 7 = " << 12 % 7 << endl;
    cout << "3 + 3.0 = " << 3 + 3.0 << endl;
    cout << "10 / 100 = " << 10 / 100.0 << endl;
    cout << "Potencia 3 a la 2 = " << pow(3, 2) << endl;

    // 1.7 Comparaciones
    int a = 10, b = 20;
    cout << "(a > b): " << (a > b) << endl;
    cout << "(a < b): " << (a < b) << endl;
    cout << "(a == b): " << (a == b) << endl;
    cout << "(a != b): " << (a != b) << endl;
    cout << "(a + b) > 100: " << ((a + b) > 100) << endl;
    cout << "(a - b) == 0: " << ((a - b) == 0) << endl;
    cout << "(a * b) > 500: " << ((a * b) > 500) << endl;
    cout << "(a * b) < 100: " << ((a * b) < 100) << endl;
    cout << "(a - b) < 0: " << ((a - b) < 0) << endl;
    cout << "a < 20: " << (a < 20) << endl;

    return 0;
}
