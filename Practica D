 //HORAS 
 #include <iostream>
using namespace std;

int main() {
    int HH, MM, SS;

    // Pedir al usuario que ingrese la hora, minutos y segundos
    cout << "Ingrese la hora (HH): ";
    cin >> HH;
    cout << "Ingrese los minutos (MM): ";
    cin >> MM;
    cout << "Ingrese los segundos (SS): ";
    cin >> SS;

    // Validar la entrada
    if (HH < 0 || HH > 23 || MM < 0 || MM > 59 || SS < 0 || SS > 59) {
        cout << "Hora no válida." << endl;
        return 1;  // Salir del programa si la entrada es inválida
    }

    // Incrementar un segundo
    SS++;

    // Ajustar los segundos, minutos y horas si es necesario
    if (SS == 60) {
        SS = 0;  // Reiniciar los segundos
        MM++;    // Incrementar un minuto

        if (MM == 60) {
            MM = 0;  // Reiniciar los minutos
            HH++;    // Incrementar una hora

            if (HH == 24) {
                HH = 0;  // Reiniciar las horas
            }
        }
    }

    // Mostrar la nueva hora
    cout << "La hora un segundo más tarde es: "
         << (HH < 10 ? "0" : "") << HH << ":"
         << (MM < 10 ? "0" : "") << MM << ":"
         << (SS < 10 ? "0" : "") << SS << endl;

    return 0;
}
