#include <iostream>
using namespace std;

int main() {
    // Declarar las variables para los tres números
    int A, B, C;

    // Pedir al usuario que ingrese los tres números
    cout << "Ingrese el valor de A: ";
    cin >> A;
    cout << "Ingrese el valor de B: ";
    cin >> B;
    cout << "Ingrese el valor de C: ";
    cin >> C;

    // Determinar el número más grande
    int mayor;
    
    if (A >= B && A >= C) {
        mayor = A;
    } else if (B >= A && B >= C) {
        mayor = B;
    } else {
        mayor = C;
    }

    // Mostrar el resultado
    cout << "El número más grande es: " << mayor << endl;

    return 0;
}
