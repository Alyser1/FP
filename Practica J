// Ejercicio 1
void ejercicio1() {
    int numero;
    do {
        cout << "Ingrese un numero (0 para salir): ";
        cin >> numero;
        if (numero != 0) {
            cout << "Resultado: " << numero * 10 << endl;
        }
    } while (numero != 0);
    cout << endl;
}

// Ejercicio 2
void ejercicio2() {
    const int TAMANO = 10;
    int arreglo[TAMANO] = {5, 12, 34, 7, 1, 90, 56, 23, 67, 18};
    int mayor = arreglo[0];

    for (int i = 1; i < TAMANO; i++) {
        if (arreglo[i] > mayor) {
            mayor = arreglo[i];
        }
    }
    cout << "El mayor elemento es: " << mayor << endl << endl;
}

// Ejercicio 3
void ejercicio3() {
    const int TAMANO = 10;
    int arreglo[TAMANO] = {5, 12, 34, 7, 1, 90, 56, 23, 67, 18};
    int suma = 0;

    for (int elemento : arreglo) {
        suma += elemento;
    }
    double promedio = static_cast<double>(suma) / TAMANO;
    cout << "El promedio es: " << promedio << endl << endl;
}

// Ejercicio 4
void ejercicio4() {
    const int TAMANO = 10;
    int arreglo[TAMANO] = {5, 12, 34, 7, 1, 90, 56, 23, 67, 18};
    int mayor = INT_MIN, segundoMayor = INT_MIN;

    for (int elemento : arreglo) {
        if (elemento > mayor) {
            segundoMayor = mayor;
            mayor = elemento;
        } else if (elemento > segundoMayor && elemento < mayor) {
            segundoMayor = elemento;
        }
    }
    cout << "El segundo mayor elemento es: " << segundoMayor << endl << endl;
}

// Ejercicio 5
void ejercicio5() {
    const int TAMANO = 10;
    int arreglo[TAMANO] = {5, 12, 34, 7, 1, 90, 56, 23, 67, 18};
    int pares = 0, impares = 0;

    for (int elemento : arreglo) {
        if (elemento % 2 == 0) {
            pares++;
        } else {
            impares++;
        }
    }
    cout << "Pares: " << pares << ", Impares: " << impares << endl << endl;
}

// Ejercicio 6
