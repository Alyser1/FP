// Ejercicio 7
void ejercicio7() {
    const int TAMANO = 1000;
    vector<int> arreglo(TAMANO);
    srand(time(NULL));

    for (int i = 0; i < TAMANO; i++) {
        arreglo[i] = rand() % 1001;
    }

    sort(arreglo.rbegin(), arreglo.rend());
    cout << "Los tres mayores elementos son: " << arreglo[0] << ", " << arreglo[1] << ", " << arreglo[2] << endl << endl;
}

// Ejercicio 8
void ejercicio8() {
    const int TAMANO = 1000;
    vector<double> arreglo(TAMANO);
    srand(time(NULL));

    for (int i = 0; i < TAMANO; i++) {
        arreglo[i] = rand() % 1001 + (rand() % 1000) / 1000.0;
    }

    sort(arreglo.begin(), arreglo.end());
    cout << "El segundo menor elemento es: " << arreglo[1] << endl << endl;
}

// Ejercicio 9
void ejercicio9() {
    const int TAMANO = 10;
    int arreglo[TAMANO] = {5, 12, 34, 7, 1, 90, 56, 23, 67, 18};

    reverse(arreglo, arreglo + TAMANO);

    cout << "Arreglo invertido: ";
    for (int elemento : arreglo) {
        cout << elemento << " ";
    }
    cout << endl << endl;
}

// Ejercicio 10
void ejercicio10() {
    const int TAMANO = 10;
    int arreglo[TAMANO];
    srand(time(NULL));

    // Generar arreglo aleatorio
    for (int i = 0; i < TAMANO; i++) {
        arreglo[i] = rand() % 101;
    }

    cout << "Arreglo original: ";
    for (int elemento : arreglo) {
        cout << elemento << " ";
    }
    cout << endl;

    // Invertir el arreglo
    reverse(arreglo, arreglo + TAMANO);

    cout << "Arreglo invertido: ";
    for (int elemento : arreglo) {
        cout << elemento << " ";
    }
    cout << endl << endl;
}

