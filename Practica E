#include <iostream>
#include <sstream>
#include <string>
#include <iomanip>
#include <algorithm>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    // Ejercicio 1.21: Ciclo de salida
    std::string respuesta;
    do {
        std::cout << "¿Quieres salir del ciclo? [SI/NO]: ";
        std::cin >> respuesta;
    } while (respuesta != "SI");

    // Ejercicio 1.22: Menú de operaciones aritméticas
    char opcion;
    int numero1, numero2, total;
    do {
        std::cout << "\nMenú de opciones:\n";
        std::cout << "a) Suma\nb) Resta\nc) Multiplicación\nd) División\ne) Residuo\ns) Salir\n";
        std::cout << "Seleccione una opción: ";
        std::cin >> opcion;

        if (opcion == 's') break;

        std::cout << "Ingrese el primer número: ";
        std::cin >> numero1;
        std::cout << "Ingrese el segundo número: ";
        std::cin >> numero2;

        switch(opcion) {
            case 'a': total = numero1 + numero2; break;
            case 'b': total = numero1 - numero2; break;
            case 'c': total = numero1 * numero2; break;
            case 'd': total = numero2 != 0 ? numero1 / numero2 : 0; break;
            case 'e': total = numero1 % numero2; break;
            default: std::cout << "Opción no válida\n"; continue;
        }
        
        std::cout << "Resultado: " << total << std::endl;

    } while(opcion != 's');

    // Ejercicio 1.23: Simulación de cajero automático
    std::string chip;
    int pin;
    float saldo = 3450.00;
    int opcion_cajero;

    std::cout << "Inserte tarjeta (valida/invalida): ";
    std::cin >> chip;
    
    if (chip != "valida") {
        std::cout << "Tarjeta inválida. Operación terminada.\n";
        return 0;
    }
    
    std::cout << "Ingrese su PIN: ";
    std::cin >> pin;
    
    if (pin != 1234) {
        std::cout << "PIN inválido.\n";
        return 0;
    }
    
    do {
        std::cout << "\n1) Consultar saldo\n2) Retiro\n3) Salir\nSeleccione una opción: ";
        std::cin >> opcion_cajero;
        
        switch(opcion_cajero) {
            case 1:
                std::cout << "Saldo actual: $" << saldo << std::endl;
                break;
            case 2:
                float retiro;
                std::cout << "Ingrese monto a retirar: ";
                std::cin >> retiro;
                if (retiro > saldo) {
                    std::cout << "Fondos insuficientes.\n";
                } else {
                    saldo -= retiro;
                    std::cout << "Retiro exitoso. Saldo restante: $" << saldo << std::endl;
                }
                break;
            case 3:
                std::cout << "Gracias por usar el cajero.\n";
                break;
            default:
                std::cout << "Opción no válida.\n";
        }
    } while(opcion_cajero != 3);

    // Ejercicio 1.24: Simulación del juego Temple Run
    int tiempo = 12;
    std::string direccion = "adelante";
    char continuar = 'y';

    std::srand(static_cast<unsigned int>(std::time(nullptr))); // Inicializar aleatoriedad

    while (tiempo > 0 && continuar != 'n') {
        bool obstaculo = std::rand() % 2; // Generar obstáculo aleatorio (0 o 1)
        bool premio = std::rand() % 2;    // Generar premio aleatorio (0 o 1)

        // Ajuste de tiempo según el obstáculo o premio
        if (obstaculo) {
            tiempo -= 3;
            std::cout << "Obstáculo encontrado. Tiempo restante: " << tiempo << std::endl;
        } else {
            tiempo -= 1;
            std::cout << "Paso sin obstáculos. Tiempo restante: " << tiempo << std::endl;
        }

        if (premio) {
            tiempo += 3;
            std::cout << "¡Premio encontrado! Tiempo aumentado: " << tiempo << std::endl;
        } else {
            tiempo += 1;
            std::cout << "Tiempo incrementado ligeramente: " << tiempo << std::endl;
        }

        // Preguntar al usuario si desea continuar
        std::cout << "¿Deseas seguir jugando? (y/n): ";
        std::cin >> continuar;
    }

    std::cout << "Juego terminado. Tiempo final: " << tiempo << std::endl;

    return 0;
}
